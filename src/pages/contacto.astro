---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
---

<Layout
  title="Inscripciones y Contacto"
  description="Formulario de contacto e inscripción de nuevos jugadores y socios del Club Deportivo El Bonillo Fútbol Sala."
>
  <section class="mx-auto max-w-xl px-6 py-14">
    <h1 class="font-display text-3xl text-stone">Inscripciones y contacto</h1>
    <p class="mt-3 text-stone/70">
      ¿Quieres unirte al club como jugador o jugadora, hacerte socio, o tienes alguna consulta?
      Escríbenos.
    </p>

    <form class="mt-10 grid gap-5" method="post">
      <label class="grid gap-1.5 text-sm font-medium text-stone">
        Nombre
        <input
          type="text"
          name="nombre"
          required
          class="border border-stone/20 bg-white px-3 py-2.5 focus:border-plum focus:outline-none"
        />
      </label>

      <label class="grid gap-1.5 text-sm font-medium text-stone">
        Email
        <input
          type="email"
          name="email"
          required
          class="border border-stone/20 bg-white px-3 py-2.5 focus:border-plum focus:outline-none"
        />
      </label>

      <label class="grid gap-1.5 text-sm font-medium text-stone">
        Mensaje
        <textarea
          name="mensaje"
          rows="5"
          required
          class="border border-stone/20 bg-white px-3 py-2.5 focus:border-plum focus:outline-none"
        ></textarea>
      </label>

      <Button class="justify-self-start">Enviar</Button>
    </form>
  </section>
</Layout>
