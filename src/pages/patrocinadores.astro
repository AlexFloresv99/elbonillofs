---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SponsorCard from '../components/ui/SponsorCard.astro';

const patrocinadores = await getCollection('patrocinadores');
const niveles = ['Main Sponsor', 'Colaborador', 'Proveedor Oficial'] as const;
---

<Layout
  title="Patrocinadores"
  description="Sponsors y colaboradores del Club Deportivo El Bonillo Fútbol Sala."
>
  <section class="mx-auto max-w-5xl px-6 py-14">
    <h1 class="font-display text-3xl text-stone">Patrocinadores</h1>
    <p class="mt-3 max-w-prose text-stone/70">
      El club compite gracias al respaldo de los negocios de El Bonillo que creen en este proyecto.
    </p>

    {
      niveles.map((nivel) => {
        const delNivel = patrocinadores.filter((s) => s.data.nivel === nivel);
        if (delNivel.length === 0) return null;
        return (
          <div class="mt-10">
            <h2 class="font-display text-lg text-plum">{nivel}</h2>
            <ul class="sponsor-grid mt-4">
              {delNivel.map((sponsor) => (
                <li>
                  <SponsorCard patrocinador={sponsor} fluida />
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>
</Layout>

<style>
  /*
   * Hasta 4 columnas; cuando una tarjeta bajaría de 8rem, la rejilla pasa
   * sola a 3, 2 o 1 columna según el ancho disponible.
   */
  .sponsor-grid {
    --gap: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(8rem, calc((100% - 3 * var(--gap)) / 4)), 1fr));
    gap: var(--gap);
    margin-inline: 0;
    padding: 0;
    list-style: none;
  }
</style>
