---
interface Props {
  nombre: string;
  apellidos: string;
  dorsal: number;
  posicion: string;
  foto?: string;
}

const { nombre, apellidos, dorsal, posicion, foto } = Astro.props;
---

<article class="flex items-center gap-5 border-t border-stone/10 py-5 first:border-t-0">
  {
    foto ? (
      <img src={foto} alt={`${nombre} ${apellidos}`} class="h-16 w-16 shrink-0 object-cover grayscale" />
    ) : (
      <p class="w-16 shrink-0 text-center font-display text-4xl leading-none text-plum">{dorsal}</p>
    )
  }
  <div class="min-w-0">
    <p class="font-display text-lg text-stone">{nombre} {apellidos}</p>
    <p class="mt-0.5 text-sm text-stone/60">{posicion}{foto ? ` · Dorsal ${dorsal}` : ''}</p>
  </div>
</article>
