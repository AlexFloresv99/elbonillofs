---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  patrocinador: CollectionEntry<'patrocinadores'>;
  /** Copia decorativa (p. ej. la segunda vuelta del carrusel): sin texto alternativo ni foco. */
  decorativa?: boolean;
  /** Ocupa todo el ancho de su celda (rejillas) en lugar de tener tamaño fijo (carrusel). */
  fluida?: boolean;
}

const { patrocinador, decorativa = false, fluida = false } = Astro.props;
const { nombre, logo, fondo, url } = patrocinador.data;
const Tag = url ? 'a' : 'div';
---

<Tag
  href={url}
  rel={url ? 'external' : undefined}
  tabindex={decorativa && url ? -1 : undefined}
  title={decorativa ? undefined : nombre}
  class:list={['sponsor-card', fondo === 'oscuro' && 'sponsor-card--dark', fluida && 'sponsor-card--fluid']}
>
  <Image
    src={logo}
    alt={decorativa ? '' : nombre}
    height={160}
    class="h-full w-full object-contain"
    loading="lazy"
    decoding="async"
  />
</Tag>

<style>
  .sponsor-card {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 11rem;
    height: 7rem;
    padding: 0.875rem;
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-stone) 10%, transparent);
    border-radius: 0.375rem;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-plum) 12%, transparent);
  }

  .sponsor-card--fluid {
    width: 100%;
    height: auto;
    aspect-ratio: 11 / 7;
    padding: clamp(0.75rem, 9%, 1.25rem);
  }

  .sponsor-card--dark {
    background: #000;
    border-color: transparent;
  }

  a.sponsor-card:hover {
    border-color: var(--color-gold);
  }
</style>
